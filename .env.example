# ═══════════════════════════════════════════════════════════════════════════════
# openDox - Environment Configuration
# Copy this file to .env and adjust values for your setup.
# Every variable supports a _FILE suffix for Docker secrets, e.g.:
#   SECRET_KEY_FILE=/run/secrets/secret_key
#
# Only deployment settings live here. Service endpoints and API keys (Whisper,
# Parakeet, LLM, EntityGuard), LDAP/OIDC, categories, audio and session policy
# are configured in the admin UI and stored in the database.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# Option A: Full URI override (bypasses individual SQL_* vars below)
# DATABASE_URI=postgresql://postgres:postgres@localhost:5432/opendox

# Option B: Individual components (recommended for Docker / secrets)
SQL_USER=postgres
SQL_PASS=postgres
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB=opendox

# ─────────────────────────────────────────────────────────────────────────────
# Security / Auth (JWT)
# ─────────────────────────────────────────────────────────────────────────────
# JWT signing key. Set a stable random value: if empty, a random key is
# generated on every start (critical log) and all sessions end on restart.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of trusted origins for CORS, e.g.:
#   CORS_ALLOWED_ORIGINS=https://opendox.example.com
# Only needed if the browser ever calls the API from a different origin
# than the one it was served from. Since the app serves both frontend and
# API from the same origin (and behind Apache that's still one public
# origin), this is usually not required — leave empty unless you have a
# genuine cross-origin use case. Empty = allow all origins (logs a warning).
CORS_ALLOWED_ORIGINS=

# Comma-separated list of IPs allowed to set X-Forwarded-Proto/-Host (used to
# build the OIDC redirect URI correctly behind a reverse proxy). Leave empty
# to auto-detect: loopback + this container's Docker gateway IP, which is
# what a reverse proxy running on the same host looks like from inside the
# container (Docker NATs host->published-port connections to appear as
# coming from the gateway, not 127.0.0.1). Only set this explicitly if the
# proxy is NOT on the same host as the app container.
TRUSTED_PROXY_IPS=

# ─────────────────────────────────────────────────────────────────────────────
# Desktop client distribution (admin UI → Clients)
# ─────────────────────────────────────────────────────────────────────────────
# Server URL written into the client's settings.json. Empty = derived from the
# admin's browser request (incl. ROOT_PATH). Set it when clients reach the server
# under a different name than the admin UI.
CLIENT_SERVER_URL=
# Base URL of the installer download buttons. Empty = latest GitHub release of
# opendox-client (releases/latest/download).
CLIENT_DOWNLOAD_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Audit log (admin UI → Audit)
# ─────────────────────────────────────────────────────────────────────────────
# Days an audit entry is kept before the daily cleanup deletes it (0 = forever).
# The log holds staff data (who changed what, failed logins): set the period
# your works-council agreement / data-protection concept allows.
AUDIT_RETENTION_DAYS=365

# ─────────────────────────────────────────────────────────────────────────────
# Field Encryption (DSGVO / §203 StGB)
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: the app refuses to start without a valid key. Encrypts patient
# transcriptions, summaries and persisted audio.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Only during a key rotation: the old key, so existing rows are re-encrypted
# with ENCRYPTION_KEY at startup. Remove it once the rotation has run (see the
# header of docker-swarm.rotation.yml for the full procedure).
# ENCRYPTION_KEY_PREVIOUS=

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Bundled Whisper / Parakeet containers (docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────
# Which servers openDox talks to is set in the admin UI (Dienste → Whisper/ASR);
# the variables below configure the containers shipped in docker-compose.yml.
#
# Bearer token the bundled Whisper container requires. Must match the final
# API key in the admin UI (the Docker migration seeds both with loc-123).
WHISPER_API_KEY=loc-123
WHISPER_MODEL=large-v3-turbo
# cuda for the GPU image, cpu for the cpu-* image.
WHISPER_DEVICE=cuda
# CTranslate2 precision: int8 (compose default, less VRAM), float16 (GPU, best
# quality), int8_float16.
WHISPER_COMPUTE_TYPE=int8
# Caps concurrent transcribe() calls against the shared whisper_model instance.
# Raise on a large/dedicated GPU, lower if Whisper shares a GPU with Parakeet
# and you see thrashing/OOM under concurrent load.
WHISPER_MAX_CONCURRENT_TRANSCRIPTIONS=4

# Parakeet (live transcription). The container defaults to the GPU (CUDA)
# image. To build a CPU-only image instead, set PARAKEET_DEVICE=cpu before
# `docker compose build`.
PARAKEET_DEVICE=gpu
# Caps concurrent ASR decode calls across all streaming sessions process-wide.
# This is a software cap independent of GPU headroom — on a large GPU (e.g.
# H200) it's usually the first thing to raise and load-test.
PARAKEET_MAX_CONCURRENT_DECODES=2
# Optional: override the ONNX providers (comma-separated). Auto-detects
# CUDAExecutionProvider when available, else CPUExecutionProvider.
# RTT_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
# Model weights: the image sets PARAKEET_QUANTIZATION itself — int8 in the CPU
# image (smaller, ~25 % faster on CPU, but recognizes drug names noticeably
# worse; the CPU image is meant for demos only), empty = FP32 in the GPU image
# (int8 is ~10x slower on CUDA). Not passed through by docker-compose.yml; to override, add
# it to the parakeet service's environment (the other variant is then
# downloaded from Hugging Face on first start).
# Optional URL sub-path (e.g. /parakeet) for reverse-proxy deployments where a
# separate edge proxy exposes Parakeet alongside other services on one port
# (e.g. next to litellm on 443, since litellm can't proxy Parakeet's native
# WS streaming protocol). Leave empty to serve at the domain root.
PARAKEET_ROOT_PATH=
# Host port the Parakeet container is published on — needed when the reverse
# proxy runs on a different host than the Docker engine.
PARAKEET_PORT=5001
# Bearer token required on /v1/audio/transcriptions and the streaming WS
# (not /v1/models, the unauthenticated healthcheck target). Must match
# whatever is configured as live_api_key/final_api_key in the Admin UI.
# Empty disables auth (dev fallback, logs a startup warning).
PARAKEET_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
# Root path for sub-path deployment (e.g. /opendox for https://example.com/opendox)
# The backend injects this into the frontend at runtime — no rebuild needed.
# Leave empty for root deployment (https://example.com/).
ROOT_PATH=
# Must mirror ROOT_PATH so the Vite dev server proxy and api.ts fallback work.
VITE_ROOT_PATH=
# Host port the app is published on by docker-compose.yml.
APP_PORT=20000

# ─────────────────────────────────────────────────────────────────────────────
# Redis (optional — Session Store)
# ─────────────────────────────────────────────────────────────────────────────
# If set, sessions are stored in Redis (recommended for Docker/production).
# If empty, sessions are stored in memory (single-instance only, lost on restart).
# docker-compose.yml sets REDIS_URL for the app itself; this is for local
# development and your own deployments.
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL_FILE=/run/secrets/redis_url

# Several app instances (docker-swarm.yml: raise the `app` replicas) require Redis, see
# docs/scaling.md. An admin's settings change reaches the other instances when
# their cached copy expires (seconds; 0 = never, single instance only).
# SETTINGS_CACHE_TTL_S=30

# ─────────────────────────────────────────────────────────────────────────────
# S3-compatible object storage (persisted audio downloads)
# ─────────────────────────────────────────────────────────────────────────────
# Any S3-compatible endpoint works (self-hosted Garage/SeaweedFS, Hetzner
# Object Storage, AWS S3, ...). Audio is encrypted client-side with
# ENCRYPTION_KEY before upload, so the storage provider never sees plaintext.
# The same bucket holds the download audio (records/) and the archived audio
# of failed transcriptions (archive/).
# docker-compose.yml defaults to the bundled local `garage` service — override
# these to point at a different provider.
S3_ENDPOINT_URL=http://localhost:3900
S3_BUCKET=opendox-audio
S3_ACCESS_KEY_ID=GK000000000000000000000001
S3_SECRET_ACCESS_KEY=
S3_REGION=garage
# Days before audio of a failed transcription is moved from chunks/failed/ to
# the bucket (encrypted); retry still works afterwards.
# FAILED_AUDIO_RETENTION_DAYS=3

# Only used by the bundled `garage` dev/test service in docker-compose.yml —
# irrelevant if you point S3_* above at an external provider.
# IMPORTANT: change both for any shared/production deployment.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Private CA (internal HTTPS endpoints, e.g. behind litellm)
# ─────────────────────────────────────────────────────────────────────────────
# The LLM client (httpx) reads SSL_CERT_FILE, the ASR/EntityGuard/health-check
# calls (requests) read REQUESTS_CA_BUNDLE. Set BOTH to the same bundle, or
# only some connections will trust the CA.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
