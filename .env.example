# ═══════════════════════════════════════════════════════════════════════════════
# openDox - Environment Configuration
# Copy this file to .env and adjust values for your setup.
# Every variable supports a _FILE suffix for Docker secrets, e.g.:
#   SECRET_KEY_FILE=/run/secrets/secret_key
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# Option A: Full URI override (bypasses individual SQL_* vars below)
# DATABASE_URI=postgresql://postgres:postgres@localhost:5432/opendox

# Option B: Individual components (recommended for Docker / secrets)
SQL_USER=postgres
SQL_PASS=postgres
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB=opendox

# ─────────────────────────────────────────────────────────────────────────────
# Security / Auth (JWT)
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Change SECRET_KEY in production!
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=ChangeThisInProduction
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# Field Encryption (DSGVO / §203 StGB)
# ─────────────────────────────────────────────────────────────────────────────
# Required for encrypted storage of patient transcriptions and summaries.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Whisper / ASR
# ─────────────────────────────────────────────────────────────────────────────
# Whisper endpoint for final transcription (GPU)
# Endpoint of the Whisper API (local container or external service)
WHISPER_API_ENDPOINT=http://localhost:9100/v1
WHISPER_API_KEY=loc-123
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda

# Parakeet endpoint for live transcription (onnx-asr, VAD-segmented streaming)
# The parakeet container defaults to the GPU (CUDA) image. To build a
# CPU-only image instead, set PARAKEET_DEVICE=cpu before `docker compose build`.
PARAKEET_API_ENDPOINT=http://localhost:5001/v1
PARAKEET_DEVICE=gpu
# Optional: override the ONNX providers (comma-separated). Auto-detects
# CUDAExecutionProvider when available, else CPUExecutionProvider.
# RTT_ONNX_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
# Root path for sub-path deployment (e.g. /opendox for https://example.com/opendox)
# The backend injects this into the frontend at runtime — no rebuild needed.
# Leave empty for root deployment (https://example.com/).
ROOT_PATH=
# Must mirror ROOT_PATH so the Vite dev server proxy and api.ts fallback work.
VITE_ROOT_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# Redis (optional — Session Store)
# ─────────────────────────────────────────────────────────────────────────────
# If set, sessions are stored in Redis (recommended for Docker/production).
# If empty, sessions are stored in memory (single-instance only, lost on restart).
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL_FILE=/run/secrets/redis_url

# ─────────────────────────────────────────────────────────────────────────────
# S3-compatible object storage (persisted audio downloads)
# ─────────────────────────────────────────────────────────────────────────────
# Any S3-compatible endpoint works (self-hosted Garage/SeaweedFS, Hetzner
# Object Storage, AWS S3, ...). MP3s are encrypted client-side with
# ENCRYPTION_KEY before upload, so the storage provider never sees plaintext.
# docker-compose.yml defaults to the bundled local `garage` service — override
# these to point at a different provider.
S3_ENDPOINT_URL=http://localhost:3900
S3_BUCKET=opendox-audio
S3_ACCESS_KEY_ID=GK000000000000000000000001
S3_SECRET_ACCESS_KEY=
S3_REGION=garage

# Only used by the bundled `garage` dev/test service in docker-compose.yml —
# irrelevant if you point S3_* above at an external provider.
# IMPORTANT: change both for any shared/production deployment.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=